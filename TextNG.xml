TestNG file Configuration


<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="AutomationSuite">

    <test name="SmokeExecution">

        <!-- Include/Exclude Groups -->
        <groups>
            <run>
                <include name="Smoke"/>
                <exclude name="Regression"/>
            </run>
        </groups>

        <classes>

            <!-- Class 1 -->
            <class name="com.demo.LoginTest">

                <!-- Include/Exclude Methods -->
                <methods>
                    <include name="login"/>
                    <include name="search"/>
                    <exclude name="logout"/>
                </methods>

            </class>

            <!-- Class 2 -->
            <class name="com.demo.PaymentTest">

                <methods>
                    <include name="refund"/>
                    <exclude name="payment"/>
                </methods>

            </class>

            <!-- To exclude a class, simply don't add it here -->

        </classes>

    </test>

</suite>